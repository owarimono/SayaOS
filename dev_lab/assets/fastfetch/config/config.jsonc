{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/fastfetch/presets/logo/sayaos.txt",
        "padding": {
            "top": 0,
            "right": 2
        }
    },
    "display": {
        "separator": " → ",
        "color": {
            "keys": "blue",
            "title": "cyan"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "kernel",
        "host",
        "uptime",
        "packages",
        "shell",
        "terminal",
        "de",
        "wm",
        "wmtheme",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "battery",
        "locale",
        "break",
        "colors"
    ]
}
